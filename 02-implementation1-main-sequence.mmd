sequenceDiagram
    actor User
    participant ST as ShapeTester
    participant R as Rectangle
    participant S as Square
    participant P as Point
    participant L as Line
    participant T as Triangle
    participant C as Circle

    User->>ST: main()

    ST->>R: new Rectangle()
    ST->>R: height = 5
    ST->>R: width = 10
    ST->>R: calcArea()
    R-->>ST: 50

    ST->>S: new Square(5)
    S->>S: height = 5
    S->>S: width = 5
    ST->>S: calcArea()
    S-->>ST: 25

    ST->>P: new Point()
    ST->>P: calcArea()
    P-->>ST: 0

    ST->>L: new Line()
    ST->>L: calcArea()
    L-->>ST: 0

    ST->>T: new Triangle(10, 10)
    ST->>T: calcArea()
    T-->>ST: 50

    ST->>C: new Circle(10)
