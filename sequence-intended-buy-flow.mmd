sequenceDiagram
    autonumber
    participant Caller
    participant OP as OrderProcessor
    participant C as Client
    participant H as Holding
    participant P as Portfolio
    participant PLS as PriceLookupService
    participant FLS as FeeLookupService

    Caller->>OP: send(orderRequest with buySide=true)
    OP->>OP: clientHasInSuffientFunds(orderRequest)
    OP->>OP: stockLacksLiquidity(orderRequest)
    OP->>C: updateHoldings(asset, quantity, true)

    C->>H: new Holding(asset, quantity)
    C->>P: holdings.add(holding)
    C->>PLS: lookup(asset.symbol)
    PLS-->>C: price
    C->>FLS: lookup(asset)
    FLS-->>C: fee
    C->>C: totalCost = price * quantity + fee
    C->>P: reduceCashHoldings(totalCost)

    OP-->>Caller: OrderResponse(200, "Success")
