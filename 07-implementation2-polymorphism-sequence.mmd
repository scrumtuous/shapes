sequenceDiagram
    actor User
    participant ST as ShapeTester
    participant A as objectA : Surface
    participant B as objectB : Surface

    User->>ST: compareShapes(objectA, objectB)

    ST->>A: calcArea()
    A-->>ST: areaA

    ST->>B: calcArea()
    B-->>ST: areaB

    ST->>ST: areaA == areaB

    alt Areas are equal
        ST-->>User: true
    else Areas are different
        ST-->>User: false
    end
